# Single shared env file for all packages in local dev.
# Lives at repo root. Copy to .env.local and fill in values.
# packages/api loads this via dotenv at startup (see packages/api/src/server.ts).
# packages/web loads this via node --env-file-if-exists in the dev script.
# .env.local is gitignored and never committed.

# ----------------------------------------------------------------------------
# MongoDB Atlas
# ----------------------------------------------------------------------------
# Cluster-level connection string (no database name in the URI).
# The database name is supplied in code via the dbName option in connectDb().
#
# For local dev, MONGODB_URI_TEST is also set here so you can run the test
# suite locally against the test database.
MONGODB_URI=mongodb+srv://<user>:<password>@atlasphere-cluster.9wzytf9.mongodb.net/
MONGODB_URI_TEST=mongodb+srv://<user>:<password>@atlasphere-cluster.9wzytf9.mongodb.net/
# MongoDB database name.
# Production: atlasphere-v2 | Dev/PR: atlasphere-v2-dev | CI: atlasphere-v2-test
# Required locally and in CI. Auto-resolved on Railway via RAILWAY_ENV_DEFAULTS.
MONGODB_DB_NAME=atlasphere-v2-dev

# ----------------------------------------------------------------------------
# Auth.js (web)
# ----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# URL of the API server (used by Next.js server components and server actions)
API_URL=http://localhost:3001

# ----------------------------------------------------------------------------
# Canonical site URL (web)
# ----------------------------------------------------------------------------
# Used for email links (verification, password reset) and social meta tags.
# Preview deployments use VERCEL_URL automatically — no config needed.
# Local dev falls back to http://localhost:3000 automatically — no config needed.
# Only set this explicitly for production or to override the automatic value.
# NEXT_PUBLIC_SITE_URL=https://atlasphere.app

# ----------------------------------------------------------------------------
# Email (Resend)
# ----------------------------------------------------------------------------
# Leave blank to skip email sending in local dev (verification tokens are
# readable directly from MongoDB in this case).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@atlasphere.app

# ----------------------------------------------------------------------------
# Registration gate (API)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed emails, or set REGISTRATION_OPEN=true to
# allow anyone to register.
REGISTRATION_ALLOWLIST=
# REGISTRATION_OPEN=true

# ----------------------------------------------------------------------------
# Cloudflare R2
# ----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2 bucket name.
# Production: atlasphere-v2 | Dev/PR: atlasphere-v2-dev
# Required locally and in CI. Auto-resolved on Railway via RAILWAY_ENV_DEFAULTS.
R2_BUCKET_NAME=atlasphere-v2-dev
# R2 public URL.
# Production: https://pub-2c867def25774b4da3d486fe0c677f64.r2.dev
# Dev/PR:     https://pub-63147a72c2cd47e8ab0f057c127fe103.r2.dev
# Required locally and in CI. Auto-resolved on Railway via RAILWAY_ENV_DEFAULTS.
R2_PUBLIC_URL=https://pub-63147a72c2cd47e8ab0f057c127fe103.r2.dev
# Same value exposed to the browser (Next.js NEXT_PUBLIC_ prefix required).
# Used by the web package to construct full image URLs from stored R2 keys.
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-63147a72c2cd47e8ab0f057c127fe103.r2.dev

# ----------------------------------------------------------------------------
# Map providers
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
# MAP_PROVIDER_OVERRIDE=mapbox
# MAPBOX_ALERT_THRESHOLD=40000
# Comma-separated list of emails allowed to toggle the map provider from the
# menu. Has no effect when MAP_PROVIDER_OVERRIDE is set (toggle is hidden).
# MAP_PROVIDER_TOGGLE_ALLOWLIST=you@example.com

# ----------------------------------------------------------------------------
# Map viewport defaults (home page initial position)
# ----------------------------------------------------------------------------
DEFAULT_LAT=33.8337
DEFAULT_LNG=-60.8509
DEFAULT_ZOOM=2

# ----------------------------------------------------------------------------
# Default marker query (comma-separated, optional)
# If set, home page shows only markers from these users / with these tags.
# Leave empty to show all public markers.
# ----------------------------------------------------------------------------
DEFAULT_QUERY_USERIDS=
DEFAULT_QUERY_TAGS=

# ----------------------------------------------------------------------------
# PostHog analytics (packages/web + packages/portal)
# ----------------------------------------------------------------------------
# Public key — used by posthog-js in the browser (web package).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Personal API key — used by the portal to query event counts via HogQL.
# Create at: app.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=
# Project ID — visible in the PostHog project URL: app.posthog.com/project/<id>
POSTHOG_PROJECT_ID=

# ----------------------------------------------------------------------------
# Portal dashboard (packages/portal)
# ----------------------------------------------------------------------------
# Password for HTTP Basic Auth on the dashboard (username: admin).
PORTAL_PASSWORD=

# Secret Vercel injects into cron route requests as Authorization: Bearer <secret>.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# Email address to send threshold alerts and weekly digests to.
PORTAL_ALERT_EMAIL=

# Vercel API token (read access to the atlasphere Vercel team).
# Create at: vercel.com/account/tokens
PORTAL_VERCEL_API_TOKEN=

# Railway API token.
# Create at: railway.app/account/tokens
PORTAL_RAILWAY_API_TOKEN=

# MongoDB Atlas Admin API credentials.
# Create at: cloud.mongodb.com > Organization > Access Manager > API Keys
# Required roles: Organization Read Only
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_ORG_ID=
ATLAS_PROJECT_ID=

# Mapbox secret token (sk.* — NOT the public pk.* token).
# Create at: account.mapbox.com > Tokens — requires statistics:read scope.
MAPBOX_SECRET_TOKEN=

# Cloudflare API token for R2 analytics.
# Create at: dash.cloudflare.com/profile/api-tokens
# Required permission: Account > Account Analytics > Read
# Note: R2_ACCOUNT_ID (above) is reused — no duplicate needed.
CLOUDFLARE_API_TOKEN=

# GitHub fine-grained PAT for reading Actions run status.
# Create at: github.com/settings/tokens — requires Actions:Read on robbear/at-2
PORTAL_GITHUB_TOKEN=

# Google Cloud service account key for Maps JS API usage metrics.
# Base64-encode the JSON key file: base64 -i key.json
# Required IAM role: Monitoring Viewer
GOOGLE_CLOUD_SA_KEY_BASE64=
GOOGLE_CLOUD_PROJECT_ID=

# ----------------------------------------------------------------------------
# V1 migration script only (scripts/migrate-v1.ts)
# Connection string for the v1 Atlas cluster (atlasphere-rob).
# Only needed when running: cd scripts && pnpm migrate-v1
# ----------------------------------------------------------------------------
MONGODB_URI_V1=mongodb+srv://<user>:<password>@atlasphere-rob.<id>.mongodb.net/
